generator client {
  provider     = "prisma-client-js"
  output       = "../src/generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Share {
  id        String   @id @default(uuid())
  userId    String   @unique()
  share     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

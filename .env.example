# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/d/prisma-config-env-vars.

# Database (PostgreSQL - Hot Storage)
DATABASE_URL="postgresql://bee:12345678@localhost:5432/hotstorage?schema=public"

# Infisical Environment
INFISICAL_ENVIRONMENT=dev

# Cold Storage Configuration (Infisical)
INFISICAL_COLD_CLIENT_ID=your_cold_client_id
INFISICAL_COLD_CLIENT_SECRET=your_cold_client_secret
INFISICAL_COLD_PROJECT_ID=your_cold_project_id

# CORS Configuration
# Comma-separated list of allowed origins (e.g., http://localhost:3000,https://example.com)
# Use * to allow all origins
CORS_ORIGIN=http://localhost:3000